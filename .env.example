# Copy to .env. Fill in your own keys; never commit or package .env.
OPENALEX_API_KEY=
OPENALEX_EMAIL=
OPENALEX_DB=data/openalex.sqlite
OPENALEX_REQUEST_TIMEOUT=30
OPENALEX_MIN_INTERVAL=1
OPENALEX_MAX_REQUESTS=500
OPENALEX_MAX_RETRIES=0
# OpenAlex's observed response cost guard; request count is also bounded.
# This is not a prepaid or preflight-guaranteed OpenAlex dollar limit.
OPENALEX_MAX_COST_USD=0.10

# OpenAI-compatible chat-completions endpoint; no hosted call on startup.
LLM_BASE_URL=https://api.openai.com/v1/
LLM_API_KEY=
LLM_MODEL=gpt-6.1-terra
LLM_TIMEOUT=120
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=omit
LLM_REASONING_EFFORT=low
# Conservative Standard-tier per-million-token rates, checked 2026-11-09:
# Terra input $1, output $5; input cache writes up to $2.50.
# Use the conservative input bound; no caching discount or credits assumed.
# https://developers.openai.com/api/docs/models/gpt-6.1-terra
LLM_INPUT_USD_PER_MILLION=2.50
LLM_OUTPUT_USD_PER_MILLION=5.00
# For another provider/model, configure its own conservative prices.
# Zero means unconfigured pricing, never free inference.
