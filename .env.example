# Copy to .env locally; never commit credentials. Offline tests need no keys.
OPENALEX_API_KEY=
OPENALEX_EMAIL=
OPENALEX_DB=data/openalex.sqlite
OPENALEX_REQUEST_TIMEOUT=30
OPENALEX_MIN_INTERVAL=1.0
OPENALEX_MAX_REQUESTS=100
OPENALEX_MAX_RETRIES=3
# Observed cost stopping threshold, not a prepaid guarantee.
OPENALEX_MAX_COST_USD=0.10
# Your provider's HTTPS chat-completions API prefix and accessible model.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=omit
# Leave blank unless the model supports this request parameter.
LLM_REASONING_EFFORT=
# Zero means unknown/unconfigured pricing, not free API access.
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
